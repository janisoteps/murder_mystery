    "notes": [
      {
        "id": "7819423c-b13b-4096-b041-422a9c2cf9da",
        "title": "Gideon Rusk",
        "text": "keeps the packing plant from collapsing or filling with teenagers. Former union steward. Knows every lock, tunnel, and machine in that plant. He’s also the man who found Wren."
      },
      {
        "id": "8e6ca1db-3298-47b1-a460-95dd878d26ee",
        "title": "South loading door",
        "text": "Was slightly open that day even though should be fully closed.\nWhoever used it either knew how to nurse that mechanism—or had a key."
      },
      {
        "id": "463861ed-d8dc-4776-a601-16867b2172cd",
        "title": "Car noise heard before the body was found",
        "text": "I heard an engine earlier. Seven-thirty, thereabouts. Didn’t see the vehicle."
      },
      {
        "id": "81663926-0fb2-4fe2-863f-233843649aac",
        "title": "June Kessler - the mayor",
        "text": "Told us about 1988 Saint Orra chemical accident—the incident people here call the Red Rain. Six night workers died in a service tunnel."
      },
      {
        "id": "04572753-74d9-4b58-ab0c-ad001fe502ce",
        "title": "Accusation",
        "text": "ask Hollis Cade why his original incident log has never been found."
      },
      {
        "id": "a86f23a5-f2d5-48e9-948c-e8fe01bb9158",
        "title": "Naomi Venn - Celia's colleague",
        "text": "Works at the radio station as the producer."
      },
      {
        "id": "3adfba1b-c852-4dd2-875e-340730c3555e",
        "title": "Dr. Amos Bell",
        "text": "threatened to break Celia's jaw after she started asking about livestock being buried off-record"
      },
      {
        "id": "248662c3-d394-4b12-bdff-31b489ddb8b3",
        "title": "Sheriff Cade",
        "text": "Sheriff Cade called Celia a parasite in the radio room."
      },
      {
        "id": "3c16fe83-4e61-4177-981a-da686c688ca9",
        "title": "Father Pike",
        "text": "Father Pike came to radio twice asking Celia not to broadcast something about Saint Orra."
      },
      {
        "id": "6bec1320-07fa-421f-9302-95b099f2b236",
        "title": "Celia's movement",
        "text": "she left the station shortly before seven."
      },
      {
        "id": "94b30460-40c6-4ce0-b0d3-56a01a47b9a7",
        "title": "Trailer near the time of murder 19:30",
        "text": "Cream-colored civic Buick. Woman behind the wheel.\ntown utility trailer past my windows toward Saint Orra Road around half past seven."
      }
    ],
